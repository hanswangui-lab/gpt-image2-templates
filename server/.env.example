IMAGE_GENERATION_COST=5
# SMTP for sending verification codes
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your@qq.com
SMTP_PASS=your_smtp_auth_code
CORS_ORIGINS=http://localhost:5173,https://你的域名.com
# 可选：HTTPS 证书路径。生产环境推荐用 nginx/Caddy 反向代理自动 TLS。
# SSL_KEY_PATH=/etc/letsencrypt/live/your-domain/privkey.pem
# SSL_CERT_PATH=/etc/letsencrypt/live/your-domain/fullchain.pem
PAYMENT_GATEWAY=
PAYMENT_PID=
PAYMENT_KEY=
PAYMENT_NOTIFY_URL=
PAYMENT_RETURN_URL=
